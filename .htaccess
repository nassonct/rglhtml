DirectoryIndex index.html
Options -Indexes

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; script-src 'self'; form-action 'self' mailto:"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /rglhtml/
  RewriteRule ^(?:\.git|\.svn|\.hg)(?:/|$) - [F,L,NC]
  RewriteRule (?:^|/)\.(?!well-known(?:/|$)) - [F,L,NC]
  RewriteRule \.(?:env|sql|ini|log|bak|old|swp|conf|dist)$ - [F,L,NC]
  # Legacy page redirects
  RewriteRule ^product-beans\.html$ pages/en/products/product-beans.html [R=301,L]
  RewriteRule ^product-groundnuts\.html$ pages/en/products/product-groundnuts.html [R=301,L]
  RewriteRule ^product-maize\.html$ pages/en/products/product-maize.html [R=301,L]
  RewriteRule ^product-milled-rice\.html$ pages/en/products/product-milled-rice.html [R=301,L]
  RewriteRule ^product-other-grains\.html$ pages/en/products/product-other-grains.html [R=301,L]
  RewriteRule ^product-sunflower\.html$ pages/en/products/product-sunflower.html [R=301,L]
  RewriteRule ^products-beans\.html$ pages/en/products/products-beans.html [R=301,L]
  RewriteRule ^products-groundnuts\.html$ pages/en/products/products-groundnuts.html [R=301,L]
  RewriteRule ^products-maize\.html$ pages/en/products/products-maize.html [R=301,L]
  RewriteRule ^products-other-grains\.html$ pages/en/products/products-other-grains.html [R=301,L]
  RewriteRule ^products-rice\.html$ pages/en/products/products-rice.html [R=301,L]
  RewriteRule ^products-sunflower\.html$ pages/en/products/products-sunflower.html [R=301,L]
  RewriteRule ^products\.html$ pages/en/products/products.html [R=301,L]
  RewriteRule ^business-agricultural-products\.html$ pages/en/businesses/business-agricultural-products.html [R=301,L]
  RewriteRule ^business-agro-processing\.html$ pages/en/businesses/business-agro-processing.html [R=301,L]
  RewriteRule ^business-energy-fuel\.html$ pages/en/businesses/business-energy-fuel.html [R=301,L]
  RewriteRule ^business-trading-distribution\.html$ pages/en/businesses/business-trading-distribution.html [R=301,L]
  RewriteRule ^businesses\.html$ pages/en/businesses/businesses.html [R=301,L]
  RewriteRule ^contact-business\.html$ pages/en/contact/contact-business.html [R=301,L]
